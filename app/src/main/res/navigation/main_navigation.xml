<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_nav"
    app:startDestination="@id/mainFragment">

    <fragment
        android:id="@+id/mainFragment"
        android:name="com.example.a2.MainFragment"
        android:label="fragment_main"
        tools:layout="@layout/fragment_main" >
        <action
            android:id="@+id/action_mainFragment_to_countriesSearchFragment"
            app:destination="@id/countriesSearchFragment" />
        <action
            android:id="@+id/action_mainFragment_to_countriesListFragment"
            app:destination="@id/countriesListFragment" />
    </fragment>
    <fragment
        android:id="@+id/countriesSearchFragment"
        android:name="com.example.a2.CountriesSearchFragment"
        android:label="fragment_countries_search"
        tools:layout="@layout/fragment_countries_search"/>
        <action
            android:id="@+id/action_countriesSearchFragment_to_countriesListFragment"
            app:destination="@id/countriesListFragment">

            <argument
            android:name="toastData"
            app:argType="string"/>
        </action>
    <fragment
        android:id="@+id/countriesListFragment"
        android:name="com.example.a2.CountriesListFragment"
        android:label="fragment_countries_list"
        tools:layout="@layout/fragment_countries_list" >
        <argument
            android:name="toastData"
            app:argType="string"
            android:defaultValue=""/>
    </fragment>
</navigation>